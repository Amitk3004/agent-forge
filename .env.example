OPENAI_API_KEY=
TAVILY_API_KEY=
WEATHER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# BEDROCK_* rather than AWS_* — Vercel reserves the AWS_* names (see lib/aws.ts).
# Locally, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY also work as a fallback for the keys.
BEDROCK_REGION=ap-south-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=